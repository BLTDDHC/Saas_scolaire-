DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/saas_scolaire
JWT_SECRET=replace-with-a-long-random-secret
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_PEER_ATTEMPTS=40
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional external notifications. Leave unset to disable a channel safely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
